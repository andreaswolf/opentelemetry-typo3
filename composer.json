{
    "name": "a9f/opentelemetry-auto-typo3",
    "description": "OpenTelemetry integration for TYPO3",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-opentelemetry": "*",
        "open-telemetry/api": "^1.7",
        "open-telemetry/sdk": "^1.10",
        "open-telemetry/sem-conv": "^1.37",
        "typo3/cms-backend": "^12.4 || ^13.4",
        "typo3/cms-core": "^12.4 || ^13.4",
        "typo3/cms-extbase": "^12.4 || ^13.4",
        "typo3/cms-frontend": "^12.4 || ^13.4",
        "typo3/cms-install": "^12.4 || ^13.4",
        "typo3/cms-redirects": "^12.4 || ^13.4"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "a9f\\OpenTelemetryTYPO3\\": "src/"
        },
        "files": [
            "_register.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs:check": "@cs:fix --diff --verbose --dry-run",
        "cs:fix": "php-cs-fixer fix --ansi"
    }
}
